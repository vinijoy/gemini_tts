{
    "model_profile": "adaptive",
    "commit_docs": true,
    "parallelization": true,
    "search_gitignored": false,
    "brave_search": false,
    "firecrawl": false,
    "exa_search": false,
    "tavily_search": false,
    "ref_search": false,
    "perplexity": false,
    "jina": false,
    "git": {
        "branching_strategy": "none",
        "create_tag": true,
        "phase_branch_template": "gsd/phase-{phase}-{slug}",
        "milestone_branch_template": "gsd/{milestone}-{slug}",
        "quick_branch_template": null
    },
    "workflow": {
        "research": true,
        "plan_check": true,
        "verifier": true,
        "nyquist_validation": false,
        "auto_advance": false,
        "node_repair": true,
        "node_repair_budget": 2,
        "ui_phase": true,
        "ui_safety_gate": true,
        "ai_integration_phase": true,
        "api_coverage_gate": true,
        "human_verify_mode": "end-of-phase",
        "context_guard_mode": "warn",
        "text_mode": false,
        "research_before_questions": false,
        "discuss_mode": "discuss",
        "skip_discuss": false,
        "code_review": true,
        "code_review_depth": "standard",
        "code_review_command": null,
        "pattern_mapper": true,
        "plan_bounce": false,
        "plan_bounce_script": null,
        "plan_bounce_passes": 2,
        "auto_prune_state": false,
        "post_planning_gaps": true,
        "security_enforcement": true,
        "security_asvs_level": 1,
        "security_block_on": "high"
    },
    "ship": {
        "pr_body_sections": []
    },
    "hooks": {
        "context_warnings": true
    },
    "project_code": null,
    "phase_naming": "sequential",
    "agent_skills": {},
    "claude_md_path": "./.claude/CLAUDE.md",
    "plan_review": {
        "source_grounding": true,
        "source_grounding_authority": "grep"
    },
    "resolve_model_ids": "omit",
    "mode": "yolo",
    "granularity": "coarse",
    "runtime": "codex",
    "model_overrides": {
        "gsd-planner": "gpt-6-astra",
        "gsd-roadmapper": "gpt-6-astra",
        "gsd-executor": "gpt-6-luna",
        "gsd-phase-researcher": "gpt-6.1-sol",
        "gsd-project-researcher": "gpt-6.1-sol",
        "gsd-research-synthesizer": "gpt-6.1-sol",
        "gsd-debugger": "gpt-6-astra",
        "gsd-codebase-mapper": "gpt-6.1-sol",
        "gsd-verifier": "gpt-6-astra",
        "gsd-plan-checker": "gpt-6-astra",
        "gsd-integration-checker": "gpt-6-astra",
        "gsd-nyquist-auditor": "gpt-6-astra",
        "gsd-pattern-mapper": "gpt-6.1-sol",
        "gsd-ui-researcher": "gpt-6.1-sol",
        "gsd-ui-checker": "gpt-6.1-sol",
        "gsd-ui-auditor": "gpt-6.1-sol",
        "gsd-doc-writer": "gpt-6-luna",
        "gsd-doc-verifier": "gpt-6.1-sol",
        "gsd-dom-verifier": "gpt-6.1-sol",
        "gsd-advisor-researcher": "gpt-6.1-sol",
        "gsd-ai-researcher": "gpt-6.1-sol",
        "gsd-assumptions-analyzer": "gpt-6-astra",
        "gsd-code-fixer": "gpt-6.1-sol",
        "gsd-code-reviewer": "gpt-6-astra",
        "gsd-debug-session-manager": "gpt-6.1-sol",
        "gsd-doc-classifier": "gpt-6-luna",
        "gsd-doc-synthesizer": "gpt-6.1-sol",
        "gsd-domain-researcher": "gpt-6.1-sol",
        "gsd-eval-auditor": "gpt-6-astra",
        "gsd-eval-planner": "gpt-6-astra",
        "gsd-framework-selector": "gpt-6-astra",
        "gsd-intel-updater": "gpt-6-luna",
        "gsd-mempalace-curator": "gpt-6.1-sol",
        "gsd-security-auditor": "gpt-6-astra",
        "gsd-user-profiler": "gpt-6.1-sol"
    }
}
